# Modelo publico. Copie para .env.meta.local e insira os valores somente localmente.
# Checker local e offline. Consulta opcional de canal faz somente GET, sem envio.
# A versao e apenas a configuracao existente do projeto, nao a mais recente validada.
META_GRAPH_API_VERSION=v24.0
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Cole o token aqui no arquivo PRIVADO, nunca em chats, capturas ou commits.
META_ACCESS_TOKEN=
# Obrigatorio manter false; o checker rejeita habilitacao.
META_OUTBOUND_ENABLED=false
