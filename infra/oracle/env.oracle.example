# ==============================================================================
# Configuracao da API na VPS Oracle Cloud Always Free Tier
# Destino na VPS: /etc/plataforma-atendimento/api.env (chown root:atende, chmod 640)
# NUNCA versione este arquivo preenchido com segredos reais no Git.
# ==============================================================================

# --- Runtime e rede (sempre em loopback atras do Caddy / Cloudflare Tunnel) ---
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# --- Modo de execucao e persistencia SQLite (R$ 0/mes, sem Postgres pago) ---
# Deixe DATABASE_URL vazio ao usar SQLite local.
DATABASE_URL=
LOCAL_SQLITE_PATH=/var/lib/plataforma-atendimento/attendance.sqlite

# Perfil 1 (canal WhatsApp em producao com SQLite, sem contas/seed de demo):
#   NODE_ENV=production
#   ENABLE_LOCAL_DEMO=false
#   WHATSAPP_CHANNEL_ENABLED=true
#
# Perfil 2 (demonstracao privada em loopback via tunel SSH; troque senhas demo antes de expor):
#   NODE_ENV=development
#   ENABLE_LOCAL_DEMO=true
#   WHATSAPP_CHANNEL_ENABLED=false
#
# Nota: verifique apps/api/src/app.ts caso a versao atual do codigo ainda exija
# ENABLE_LOCAL_DEMO=true para inicializar localDatabase com SQLite.
NODE_ENV=production
ENABLE_LOCAL_DEMO=false

# --- Canal WhatsApp ---
WHATSAPP_CHANNEL_ENABLED=true
WHATSAPP_PROVIDER=unofficial_qr
WHATSAPP_SESSION_DIR=/var/lib/plataforma-atendimento/whatsapp/sessions
WHATSAPP_STATE_DIR=/var/lib/plataforma-atendimento/whatsapp/state
WHATSAPP_PROACTIVE_ENABLED=false
WHATSAPP_WARMUP_DAYS=7
WHATSAPP_QUIET_START=21
WHATSAPP_QUIET_END=8
WHATSAPP_TIME_ZONE=America/Sao_Paulo
WHATSAPP_MAX_LINKS=1

# Origem publica do painel (OBRIGATORIA quando acessado via dominio HTTPS no Caddy/Cloudflare)
# Exemplo: WHATSAPP_PANEL_ORIGINS=https://atende.seu-dominio.com
WHATSAPP_PANEL_ORIGINS=

# --- Webhooks Meta (obrigatorios quando NODE_ENV=production) ---
# Gere tokens aleatorios fortes: openssl rand -hex 32
META_VERIFY_TOKEN=troque-por-token-aleatorio-forte
META_APP_SECRET=troque-por-segredo-meta-ou-aleatorio-forte
META_REQUIRE_SIGNATURE=true
META_GRAPH_API_VERSION=v24.0

# --- Gateway de IA (opcional - OpenRouter recomendado para VPS sem GPU) ---
LLM_PROVIDER=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1
LLM_HTTP_REFERER=
LLM_APP_TITLE=Plataforma de atendimento
LLM_FAILURE_MESSAGE=Nao consegui responder agora. Vou transferir voce para uma pessoa.
LLM_FAILURE_ACTION=reply_and_handoff
LLM_SUPPORTS_TOOLS=true
BOT_SESSION_TTL_MINUTES=60

# --- RAG híbrido (SQLite ou PostgreSQL; embeddings opcionais) ---
RAG_ENABLED=true
# none | openrouter | local
RAG_EMBEDDING_PROVIDER=none
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_TOP_K_CATALOG=8
RAG_TOP_K_KNOWLEDGE=5
RAG_TIMEOUT_MS=8000
