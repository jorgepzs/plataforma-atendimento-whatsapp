NODE_ENV=development
ENABLE_LOCAL_DEMO=false
# Apenas para o atendimento local em loopback; não combinar com DATABASE_URL.
LOCAL_SQLITE_PATH=
LOCAL_AI_ENABLED=false
# Nome de um modelo Ollama já instalado localmente; só usado quando LOCAL_AI_ENABLED=true.
LOCAL_AI_MODEL=
# Envio Cloud API somente para teste local explicitamente autorizado; permanece desligado.
WHATSAPP_OUTBOUND_ENABLED=false
WHATSAPP_OUTBOUND_PHONE_NUMBER_ID=
WHATSAPP_OUTBOUND_ACCESS_TOKEN=
# Apenas números de teste E.164 sem +, separados por vírgula. Nunca habilite sem revisar.
WHATSAPP_OUTBOUND_ALLOWED_RECIPIENTS=
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
POSTGRES_PASSWORD=defina-uma-senha-url-safe-longa
DATABASE_URL=postgresql://sou:defina-uma-senha-url-safe-longa@localhost:5432/sou

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=troque-este-token
META_APP_SECRET=
META_REQUIRE_SIGNATURE=true
META_GRAPH_API_VERSION=v24.0

# Usado pelo Caddy na VPS. Em desenvolvimento pode permanecer localhost.
APP_DOMAIN=localhost

