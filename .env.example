NODE_ENV=development
ENABLE_LOCAL_DEMO=false
# Apenas para o atendimento local em loopback; não combinar com DATABASE_URL.
LOCAL_SQLITE_PATH=
LOCAL_AI_ENABLED=false
# Nome de um modelo Ollama já instalado localmente; só usado quando LOCAL_AI_ENABLED=true.
# Este modo antigo só escolhe uma FAQ aprovada no endpoint nativo do Ollama. O gateway abaixo
# é o caminho para OpenRouter e para a API compatível com OpenAI (Ollama /v1 ou LM Studio).
LOCAL_AI_MODEL=

# Gateway de IA. Vazio desliga o recurso. Troque só estas variáveis para mudar de provedor.
# openrouter: indicado para produção. local: Ollama ou LM Studio, indicado para desenvolvimento.
# IA local exige a máquina do modelo ligada o tempo todo; não use como atendimento de produção.
LLM_PROVIDER=
# OpenRouter: https://openrouter.ai/api/v1
# Ollama nesta máquina: http://127.0.0.1:11434/v1
# LM Studio nesta máquina: http://127.0.0.1:1234/v1
# API no Docker e modelo no Windows: http://host.docker.internal:11434/v1
LLM_BASE_URL=
# Obrigatória no OpenRouter. No Ollama pode ficar vazia. No LM Studio use uma chave qualquer, se o servidor exigir.
LLM_API_KEY=
# Ex.: openai/gpt-4o-mini no OpenRouter, ou qwen2.5:1.5b no Ollama.
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1
# Cabeçalhos recomendados pelo OpenRouter. São enviados somente quando LLM_PROVIDER=openrouter.
LLM_HTTP_REFERER=http://localhost
LLM_APP_TITLE=Plataforma de atendimento
LLM_FAILURE_MESSAGE=Não consegui responder agora. Vou transferir você para uma pessoa.
# reply | handoff | reply_and_handoff
LLM_FAILURE_ACTION=reply_and_handoff
LLM_SUPPORTS_TOOLS=true
# Contexto temporário da conversa do bot; o transcript completo segue salvo no painel.
BOT_SESSION_TTL_MINUTES=60
# Envio Cloud API somente para teste local explicitamente autorizado; permanece desligado.
WHATSAPP_OUTBOUND_ENABLED=false
WHATSAPP_OUTBOUND_PHONE_NUMBER_ID=
WHATSAPP_OUTBOUND_ACCESS_TOKEN=
# Apenas números de teste E.164 sem +, separados por vírgula. Nunca habilite sem revisar.
WHATSAPP_OUTBOUND_ALLOWED_RECIPIENTS=
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
POSTGRES_PASSWORD=defina-uma-senha-url-safe-longa
DATABASE_URL=postgresql://sou:defina-uma-senha-url-safe-longa@localhost:5432/sou

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=troque-este-token
META_APP_SECRET=
META_REQUIRE_SIGNATURE=true
META_GRAPH_API_VERSION=v24.0

# Usado pelo Caddy na VPS. Em desenvolvimento pode permanecer localhost.
APP_DOMAIN=localhost

# Canal WhatsApp. Permanece desligado até WHATSAPP_CHANNEL_ENABLED=true.
# unofficial_qr usa Baileys no próprio processo da API. meta_cloud usa a Cloud API.
WHATSAPP_CHANNEL_ENABLED=false
WHATSAPP_PROVIDER=unofficial_qr
# Desativa tetos e bloqueios anti-spam apenas em desenvolvimento local com demo + SQLite + loopback. Não usar fora de testes locais.
WHATSAPP_TEST_UNLIMITED=false
# Diretório persistente da sessão QR. O estado anti-ban fica ao lado, com sufixo -state, se WHATSAPP_STATE_DIR ficar vazio.
WHATSAPP_SESSION_DIR=
WHATSAPP_STATE_DIR=
# POST JSON quando a sessão cai por logout, banimento, restrição ou sessão duplicada. Sem corpo de mensagem.
WHATSAPP_ALERT_WEBHOOK_URL=
# Origens extras do painel, separadas por vírgula. Ex.: https://atende.example
WHATSAPP_PANEL_ORIGINS=
# Credenciais globais da Cloud API. A empresa pode gravar as próprias e o token não volta na API.
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
# Tetos anti-ban. Vazios usam o padrão conservador documentado no README.
WHATSAPP_PROACTIVE_ENABLED=false
WHATSAPP_MESSAGES_PER_MINUTE=
WHATSAPP_MESSAGES_PER_HOUR=
WHATSAPP_DAILY_CAP=
WHATSAPP_MIN_DELAY_MS=
WHATSAPP_MAX_DELAY_MS=
WHATSAPP_FIRST_MESSAGE_DELAY_MS=
WHATSAPP_WARMUP_DAYS=7
WHATSAPP_QUIET_START=21
WHATSAPP_QUIET_END=8
WHATSAPP_TIME_ZONE=America/Sao_Paulo
WHATSAPP_MAX_LINKS=1

# RAG híbrido persistido em SQLite local e PostgreSQL.
# Sem embeddings usa ranking lexical; PostgreSQL também usa FTS português.
# Embeddings opcionais adicionam busca vetorial nos dois armazenamentos.
RAG_ENABLED=true
# none | openrouter | local
RAG_EMBEDDING_PROVIDER=none
# OpenRouter: https://openrouter.ai/api/v1 | Ollama local: http://127.0.0.1:11434/v1
RAG_EMBEDDING_BASE_URL=
# Opcional: quando RAG_EMBEDDING_PROVIDER=openrouter, herda LLM_API_KEY se vazia.
RAG_EMBEDDING_API_KEY=
# OpenRouter padrão: openai/text-embedding-3-small | Ollama padrão: nomic-embed-text
RAG_EMBEDDING_MODEL=
RAG_TOP_K_CATALOG=8
RAG_TOP_K_KNOWLEDGE=5
RAG_TIMEOUT_MS=8000

